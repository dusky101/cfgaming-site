---
// The top of every page but Home: its one h1, and a line under it.
interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<div class="page-header wrap">
  <h1>{title}</h1>
  <p class="lead">{lead}</p>
  <slot />
</div>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
  }
</style>
