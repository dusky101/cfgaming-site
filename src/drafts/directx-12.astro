---
// A draft, shown only by `npm run dev` (astro.config.mjs): DirectX 12 games once CF Gaming no longer carries Apple's
// D3DMetal (stages 27e and 27f of CF Gaming's plan). Written from the plan, ahead of the app, at Marc's request
// ("create that too. but just hide it for now"). Phase 07 checks every line against the app before it's published.
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import NextSteps from "../components/NextSteps.astro";
import PageHeader from "../components/PageHeader.astro";
import { pages } from "../lib/site";

const appleDownloads = "https://developer.apple.com/download/all/?q=game%20porting%20toolkit";
---

<BaseLayout
  title="DirectX 12 games"
  description="DirectX 12 games need Apple's D3DMetal, from Apple's free Game Porting Toolkit: a free Apple developer account, one download, and CF Gaming does the rest."
>
  <PageHeader
    icon="monitor"
    title="DirectX 12 games"
    lead="They play through Apple's D3DMetal, which Apple gives out itself. A free account, one download, and CF Gaming does the rest."
  />

  <div class="wrap stack">
    <section class="glass panel" aria-labelledby="why">
      <div class="with-tile">
        <span class="tile"><Icon name="layers" /></span>
        <h2 id="why">Why it's a download from Apple</h2>
      </div>
      <p>
        CF Gaming plays DirectX 12 games through <strong>D3DMetal</strong>, part of Apple's <strong>Game Porting Toolkit</strong>. Apple gives the toolkit out itself, free, to anyone with an Apple developer account, so it doesn't come with CF Gaming: you download it once, from Apple, and CF Gaming sets it up.
      </p>
      <p class="muted">Games made for DirectX 11 and older don't need it.</p>
    </section>

    <section class="glass panel" aria-labelledby="you-need">
      <div class="with-tile">
        <span class="tile"><Icon name="person" /></span>
        <h2 id="you-need">What you need</h2>
      </div>
      <ul class="ticks" role="list">
        <li>
          <strong>An Apple Account:</strong> the one you use for the App Store or iCloud will do.
        </li>
        <li>
          <strong>A free Apple developer account:</strong> the first time you sign in to Apple's developer site, Apple asks you to accept its developer agreement. That's all: you don't need to pay for the Apple Developer Program.
        </li>
      </ul>
    </section>

    <section class="glass panel" aria-labelledby="steps">
      <h2 id="steps">Four steps</h2>
      <ol class="steps" role="list">
        <li>
          <span class="tile tile-number">1</span>
          <div>
            <h3>Choose Add DirectX 12 in CF Gaming</h3>
            <p>
              It's in <strong>Settings › Engine</strong>, and CF Gaming offers it when you set up a DirectX 12 game. It says what's needed, then opens Apple's downloads page in your own browser.
            </p>
          </div>
        </li>
        <li>
          <span class="tile tile-number">2</span>
          <div>
            <h3>Sign in to Apple's developer site</h3>
            <p>With your Apple Account. The first time, accept Apple's developer agreement.</p>
          </div>
        </li>
        <li>
          <span class="tile tile-number">3</span>
          <div>
            <h3>Download Game Porting Toolkit 4</h3>
            <p>
              Let it go into your Downloads folder. To find it without CF Gaming, it's on <a href={appleDownloads}>Apple's downloads page</a>.
            </p>
          </div>
        </li>
        <li>
          <span class="tile tile-number">4</span>
          <div>
            <h3>CF Gaming does the rest</h3>
            <p>
              It sees the download arrive, checks that its files are Apple's, and copies D3DMetal into your own CF Gaming folder. Then it offers to remove the disk image, which isn't needed after that.
            </p>
          </div>
        </li>
      </ol>
      <p class="muted">
        From then on, DirectX 12 games play with D3DMetal by themselves: <strong>Graphics › Auto</strong> chooses it.
      </p>
    </section>

    <section class="glass panel" aria-labelledby="once">
      <div class="with-tile">
        <span class="tile"><Icon name="people" /></span>
        <h2 id="once">Once for each account on the Mac</h2>
      </div>
      <p>
        D3DMetal is kept in your own CF Gaming folder, so each account on the Mac does this once. Updates to CF Gaming keep it where it is.
      </p>
    </section>

    <section class="glass panel" aria-labelledby="password">
      <div class="with-tile">
        <span class="tile"><Icon name="lock" /></span>
        <h2 id="password">Your Apple password stays with Apple</h2>
      </div>
      <p>
        You sign in on Apple's own site, in your own browser. CF Gaming never asks for your Apple password and never sees it: all it looks for is the toolkit's disk image in your Downloads folder.
      </p>
    </section>
  </div>

  <NextSteps items={[pages.beforeYouStart, pages.install]} />
</BaseLayout>
