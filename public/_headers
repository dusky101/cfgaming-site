# Cloudflare reads this file from the site's root and adds these headers to every response it serves from it.
# The site loads nothing from anywhere else: no scripts at all, styles and pictures only from cfgaming.app.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro names these files by their contents, so a changed file always has a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
