# Cloudflare reads this file from the site's root and adds these headers to every response it serves from it.
# The site loads nothing from anywhere else: no scripts at all, styles and pictures only from cfgaming.app.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The previews and version addresses on workers.dev stay out of search: cfgaming.app is the site's address. Cloudflare's
# own example from its Workers headers docs; the placeholders match any <name>.<subdomain>.workers.dev, and only those,
# so cfgaming.app never gets it (checked on both on 14 November).
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Astro names these files by their contents, so a changed file always has a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
