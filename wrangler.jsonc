// How Cloudflare serves the site: a Worker with static assets only (no code of its own), serving dist/ as Astro builds
// it. Workers Builds reads this at each push: the dashboard's build command (`npm run build`) makes dist/. On main,
// `npx wrangler deploy` publishes it to cfgaming.app; on any other branch (preview), `npx wrangler preview` makes that
// branch's Preview instead. From Cloudflare's Astro guide, Wrangler's settings and Worker Previews (read 13 and 14
// November 2026).
{
  // Must match the Worker's name in Cloudflare's dashboard, or the build fails.
  "name": "cfgaming-site",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    // An address the site doesn't have gets dist/404.html with a 404 status. Without this, the page is empty.
    "not_found_handling": "404-page",
    // /about/ is dist/about/index.html, and /about goes there (307). Cloudflare's default, written down.
    "html_handling": "auto-trailing-slash"
  },
  // The live site's only address is cfgaming.app: the Worker's own *.workers.dev address stays off.
  "workers_dev": false,
  // Previews (and version addresses) are served on *.workers.dev, which Cloudflare and public/_headers mark noindex.
  // Production and preview workers.dev addresses are set separately; without this, a Preview has no address.
  "preview_urls": true,
  // `npx wrangler preview` needs this block, even empty: the Preview uses the settings above as they are.
  "previews": {}
}
